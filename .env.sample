DB_NAME=climweb
DB_USER=climweb
DB_PASSWORD=

# Host port for the admin (8000 is often taken). Not CLIMWEB_PORT: that one is
# read by the ClimWeb entrypoint and changes the port *inside* the container.
BULLETIN_STUDIO_PORT=8010

# Uncomment to load the frontend from a running `npm run dev` in ../bulletin-studio-js.
# BULLETIN_STUDIO_DEV_SERVER=http://localhost:5180
